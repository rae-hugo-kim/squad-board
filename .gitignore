# Harness runtime state (project-local, transient)
.omp/harness-state/
.omp/state/

# Local archives (intentionally untracked; visible in the Obsidian vault)
docs/sum/
docs/brainstorming/
docs/reviews/
docs/harness/*-skip
docs/harness/*-done

# OMC state, if OMC tooling is used alongside (transient)
.omc/

# Serena MCP tool state (per-machine, transient)
.serena/

# Obsidian vault config (viewer-local UI state, per-machine)
.obsidian/

# Human-facing one-off HTML artifacts (see artifacts/README.md)
# Pattern: ignore everything under artifacts/, but keep README.md at any depth
# so subdirectory structure is documented (recursive ** for nested subdirs).
artifacts/**
!artifacts/**/
!artifacts/README.md
!artifacts/**/README.md

# --- Next.js / Node (Squad Board 앱) ---
/node_modules
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
*.pem
.vercel

# env files (.env.example 만 커밋)
.env*
!.env.example

# SQLite 데이터
/data/
