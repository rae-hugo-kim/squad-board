# 복사해서 .env.local 로 저장한 뒤 값을 채우세요. (.env.local 은 git에 올라가지 않습니다)

# 소모임 공용 패스코드 (4자 이상). 유출 시 이 값만 바꾸면 전원 재입장.
SQUAD_PASSCODE=change-me

# 세션 쿠키 서명 키 (32자 이상 무작위). 생성 예: openssl rand -hex 32
SESSION_SECRET=replace-with-64-hex-characters-from-openssl-rand-hex-32-xxxxxxxx

# SQLite 파일 경로. Turso 전환 시 libsql://... 과 DATABASE_AUTH_TOKEN 설정
DATABASE_URL=file:./data/squad.db
# DATABASE_AUTH_TOKEN=

# 최초 시드 시 만들 관리자 닉네임 (멤버가 0명일 때만 생성)
SEED_ADMIN_NICKNAME=admin
