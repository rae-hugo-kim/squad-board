{
  "name": "squad-board",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node --import tsx src/db/deploy.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env.local --import tsx src/db/migrate.ts",
    "db:seed": "node --env-file=.env.local --import tsx src/db/seed.ts",
    "db:studio": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs studio",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "e2e": "node e2e/stage1.mjs",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "e2e:stage2": "node e2e/stage2.mjs",
    "e2e:stage3": "node e2e/stage3.mjs",
    "e2e:stage4": "node e2e/stage4.mjs",
    "db:deploy": "node --import tsx src/db/deploy.ts",
    "assets:sync": "node --env-file=.env.local --import tsx src/db/sync-assets.ts",
    "e2e:stage5": "node e2e/stage5.mjs",
    "e2e:stage6": "node e2e/stage6.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.3",
    "next": "16.4.0",
    "pretendard": "^1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
